__pycache__/
*.egg-info/

# Settings with allocation and paths
/tacc.env
.env

# Data and results: folders wherever a run writes them (DATA_ROOT / OUTPUT_ROOT inside the repo)
/data/
/data*/
/outputs/
/outputs*/
/results*/
/slurm_logs/
slurm-*.out
hf_cache/
/ablations/*_tacc.tsv

