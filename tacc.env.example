# TACC settings for slurm/submit.sh. Copy to tacc.env (not committed) and fill in:
#   cp tacc.env.example tacc.env && nano tacc.env
# Put a path in quotes if it contains spaces.

# TACC project to charge (listed by /usr/local/etc/taccinfo).
ALLOCATION=

# ls6 (Lonestar6, 3 A100s per node) or vista (1 GH200 per node).
SYSTEM=ls6

# TRIDENT output folder holding features_virchow2/ and features_uni_v2/ (one .h5 per slide).
# To train on several datasets together, list their folders separated by ':', e.g.
#   TRIDENT_DIR=/path/tcga/20x_256px_0px_overlap:/path/ccdi_mci/20x_256px_0px_overlap
TRIDENT_DIR=/scratch/<project>/<user>/<path to TRIDENT output>/contours_hest_0.5_holes/20x_256px_0px_overlap

# Slides to import: a CSV with columns slide_id (the TRIDENT .h5 name without .h5), project (the
# label the comparison probes predict, e.g. diagnosis) and patient (keeps a patient's slides in one
# split). Leave empty for TCGA alone, which uses manifests/tcga_dx_all.csv. With several
# datasets, list one manifest per dataset, separated by ':', e.g.
#   MANIFEST=manifests/tcga_dx_all.csv:/path/ccdi_manifest.csv
MANIFEST=

# Projects to keep, comma-separated. Empty: TCGA-GBM,TCGA-LGG for TCGA, every project otherwise.
PROJECTS=

# Optional: the .svs folder TRIDENT read. Only the Emb2Img stages need it.
SLIDES_DIR=/scratch/<project>/<user>/<path to the .svs slides>

# Imported features and SAE stores. Rebuildable, so $SCRATCH is fine.
DATA_ROOT=$SCRATCH/picasso/data_brain

# Checkpoints and results. Keep on $WORK: $SCRATCH deletes files that go unused.
OUTPUT_ROOT=$WORK/picasso/outputs_brain

# Conda install and env name. setup creates the env if it is missing.
CONDA_SH=$WORK/miniconda3/etc/profile.d/conda.sh
CONDA_ENV=picasso
